# Фронтенд: публичные значения (Project Settings → API). Их можно отдавать в браузер.
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=публичный_anon_или_publishable_ключ

# Только для локальных скриптов (миграции, тестовые данные). НЕ попадают во фронтенд и в git.
DATABASE_URL=postgresql://postgres.xxxx:ПАРОЛЬ@aws-0-xx.pooler.supabase.com:5432/postgres
SUPABASE_SERVICE_ROLE_KEY=секретный_ключ
SEED_PASSWORD=пароль_для_тестовых_пользователей
